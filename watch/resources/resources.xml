<resources>
    <string id="AppName">Workout Path</string>
    <string id="FieldStep">Step</string>
    <string id="FieldReps">Reps</string>
    <string id="FieldHold">Hold</string>
    <string id="UnitReps">reps</string>
    <string id="UnitSec">s</string>
    <string id="UnitNone"> </string>
    <string id="SyncUrlTitle">Sync address</string>
    <string id="SyncUrlPrompt">Copy it from the web app: Sync &amp; backup → Watch app address</string>

    <!-- The sync address, set in the Connect IQ phone app (Workout Path → Settings). Never in the package: the repo
         is public and the address reads the gist. -->
    <properties>
        <property id="syncUrl" type="string"></property>
    </properties>
    <settings>
        <setting propertyKey="@Properties.syncUrl" title="@Strings.SyncUrlTitle" prompt="@Strings.SyncUrlPrompt">
            <settingConfig type="alphaNumeric" />
        </setting>
    </settings>

    <bitmap id="LauncherIcon" filename="images/launcher.png" />

    <!-- My numbers per lap, shown in Garmin Connect (if it shows them for a sideloaded app: W1 checks). -->
    <fitContributions>
        <fitField id="0" displayInChart="false" displayInActivityLaps="true" sortOrder="0"
                  dataLabel="@Strings.FieldStep" unitLabel="@Strings.UnitNone" />
        <fitField id="1" displayInChart="false" displayInActivityLaps="true" sortOrder="1"
                  dataLabel="@Strings.FieldReps" unitLabel="@Strings.UnitReps" />
        <fitField id="2" displayInChart="false" displayInActivityLaps="true" sortOrder="2"
                  dataLabel="@Strings.FieldHold" unitLabel="@Strings.UnitSec" />
    </fitContributions>
</resources>
